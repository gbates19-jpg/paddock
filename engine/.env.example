# Copy to .env (gitignored) and fill in. Never commit real values.

# replay | paper | live — live is hard-disabled in Phase 0, see paddock/config/settings.py
PADDOCK_MODE=replay

# Only required for PADDOCK_MODE=live in Phase 1 — physically impossible in Phase 0.
# PADDOCK_LIVE_ACK=I_UNDERSTAND_REAL_MONEY

# Free delayed app key — see README "Getting the free delayed key"
PADDOCK_BETFAIR_USERNAME=
PADDOCK_BETFAIR_PASSWORD=
PADDOCK_BETFAIR_APP_KEY=

# Phase 1 only — the paid £299 live key. Leave unset in Phase 0.
PADDOCK_BETFAIR_LIVE_APP_KEY=

# Cert-based non-interactive login (used when both are set; otherwise falls
# back to interactive username/password login).
PADDOCK_BETFAIR_CERT_FILE=
PADDOCK_BETFAIR_KEY_FILE=

PADDOCK_API_CORS_ORIGIN=http://localhost:5173
PADDOCK_API_HOST=0.0.0.0
PADDOCK_API_PORT=8000

# Local dev default is <repo_root>/data (computed, no need to set this).
# In docker-compose this is bind-mounted to /data instead — set explicitly
# to /data only inside a container.
# PADDOCK_DATA_DIR=/data
